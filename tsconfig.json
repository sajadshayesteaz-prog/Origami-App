{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "noUnusedLocals": true,
    "paths": {
      "@origami/engine": [
        "./packages/engine/src/index.ts"
      ]
    }
  },
  "include": [
    "app/src",
    "packages/engine/src",
    "packages/engine/test",
    "tools/library-server.ts"
  ]
}
