{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origami-app.local/schema/step.schema.json",
  "title": "Step",
  "description": "One teaching step of a model.",
  "type": "object",
  "required": ["index", "image"],
  "additionalProperties": false,
  "properties": {
    "index": { "type": "integer", "minimum": 1, "description": "Step number as printed in the book." },
    "image": { "type": "string", "pattern": "^steps/[0-9]{3}[.](png|svg)$", "description": "Path relative to the model folder." },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fa": { "type": "string" }, "en": { "type": "string" } }
    },
    "notes": { "type": "string" },
    "foldFrame": { "type": "integer", "minimum": 0, "description": "Index into file_frames of the model's fold3D file." }
  }
}
